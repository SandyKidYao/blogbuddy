{
  "name": "blogbuddy",
  "displayName": "Blog Buddy",
  "description": "A WYSIWYG Markdown editor for VS Code with margin notes: leave a sentence beside a block, keep writing, and read your agent's answer when you are ready.",
  "version": "0.2.0",
  "icon": "images/icon.png",
  "publisher": "FulcrumStudio",
  "repository": {
    "url": "https://github.com/SandyKidYao/blogbuddy.git",
    "type": "git"
  },
  "engines": {
    "vscode": "^1.102.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onLanguage:markdown"
  ],
  "main": "./dist/extension.js",
  "l10n": "./l10n",
  "contributes": {
    "customEditors": [
      {
        "viewType": "blogbuddy.editor",
        "displayName": "BB Editor",
        "selector": [
          {
            "filenamePattern": "*.md"
          }
        ],
        "priority": "option"
      }
    ],
    "commands": [
      {
        "command": "blogbuddy.openEditor",
        "title": "%command.openEditor%",
        "icon": {
          "light": "images/icon.png",
          "dark": "images/icon.png"
        }
      },
      {
        "command": "blogbuddy.openSource",
        "title": "%command.openSource%",
        "icon": "$(code)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "blogbuddy.openEditor",
          "when": "resourceExtname == .md && resourceScheme == file",
          "group": "navigation@-10"
        },
        {
          "command": "blogbuddy.openSource",
          "when": "activeCustomEditorId == 'blogbuddy.editor'",
          "group": "navigation@-10"
        }
      ]
    },
    "keybindings": [
      {
        "command": "blogbuddy.openEditor",
        "key": "ctrl+shift+b",
        "mac": "cmd+shift+b",
        "when": "(filesExplorerFocus && resourceExtname == .md) || editorLangId == markdown"
      },
      {
        "command": "blogbuddy.openSource",
        "key": "ctrl+shift+b",
        "mac": "cmd+shift+b",
        "when": "activeCustomEditorId == 'blogbuddy.editor'"
      }
    ],
    "configuration": {
      "type": "object",
      "title": "Blog Buddy",
      "properties": {
        "blogbuddy.agent": {
          "type": "string",
          "enum": [
            "auto",
            "claude",
            "codex"
          ],
          "default": "auto",
          "enumDescriptions": [
            "%config.agent.auto%",
            "%config.agent.claude%",
            "%config.agent.codex%"
          ],
          "description": "%config.agent%",
          "order": 1
        },
        "blogbuddy.assetDir": {
          "type": "string",
          "default": "",
          "description": "%config.assetDir%",
          "order": 2
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit && tsc --noEmit -p tsconfig.webview.json",
    "lint": "eslint src",
    "test": "vscode-test",
    "test:unit": "npm run compile-tests && mocha --ui tdd out/test/utils/frontmatter.test.js out/test/utils/MarkdownStatsAnalyzer.test.js out/test/services/textSync.test.js out/test/services/agentProtocol.test.js out/test/core/blockDiff.test.js out/test/core/notes.test.js out/test/l10n.test.js",
    "deploy": "vsce publish"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/mocha": "^10.0.10",
    "@types/node": "20.x",
    "@types/vscode": "^1.102.0",
    "@typescript-eslint/eslint-plugin": "^8.31.1",
    "@typescript-eslint/parser": "^8.31.1",
    "@vscode/l10n-dev": "^0.0.35",
    "@vscode/test-cli": "^0.0.11",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.9.1",
    "esbuild": "^0.25.3",
    "eslint": "^9.25.1",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/collab": "^6.1.1",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-go": "^6.0.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-java": "^6.0.2",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.13.1",
    "@codemirror/legacy-modes": "^6.5.5",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/common": "^1.5.5",
    "@lezer/highlight": "^1.2.5",
    "@lezer/markdown": "^1.8.1",
    "@vscode/l10n": "^0.0.18",
    "js-yaml": "^4.1.1"
  }
}
